#!/bin/bash
#
# hop — manage the SSH machines the Hop bar plugin offers, and open
# sessions to them in the default Omarchy terminal.
#
# The plugin panel is a front-end for this script: the QML never touches the
# store or builds an ssh command itself, so anything the bar can do is
# available from a keybinding, a script, or another terminal.
#
# No password is ever stored. ssh prompts in the terminal it opens, exactly
# as it would if you had typed the command yourself, so keys, agents,
# ProxyJump and everything else in ~/.ssh/config keep working.

set -euo pipefail

CONFIG_DIR="${HOP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/hop}"
STORE="$CONFIG_DIR/hosts.json"
APP_ID="org.omarchy.hop"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
STORE_READER="$SCRIPT_DIR/hop-read-store"

die() {
  echo "hop: $1" >&2
  exit 1
}

command -v jq >/dev/null || die "jq is required"
command -v python3 >/dev/null || die "python3 is required"

ensure_config_dir() {
  [[ ! -L $CONFIG_DIR ]] || die "refusing symlink config path: $CONFIG_DIR"
  mkdir -p "$CONFIG_DIR"
  [[ -d $CONFIG_DIR && ! -L $CONFIG_DIR ]] \
    || die "refusing non-directory config path: $CONFIG_DIR"
  chmod 700 "$CONFIG_DIR" 2>/dev/null || true
}

# The long-lived QML process receives only JSON that this short-lived helper
# has opened nonblocking and no-follow, descriptor-validated as a regular file,
# size-capped, and parsed. A missing store is the normal empty-store case.
read_store() {
  python3 "$STORE_READER" "$STORE"
}

read_hosts() {
  python3 "$STORE_READER" --hosts "$STORE"
}

# Every write lands through a temp file in the same directory so a crash
# mid-write leaves the previous store intact rather than a truncated one, and
# through the same validator the reader uses, so a value that would be dropped
# on the next read is refused now, while the user is still there to see why.
write_store() {
  local tmp
  ensure_config_dir
  tmp=$(mktemp "$CONFIG_DIR/.hosts.XXXXXX")
  python3 "$STORE_READER" --check >"$tmp" || {
    rm -f "$tmp"
    exit 1
  }
  chmod 600 "$tmp"
  # -T replaces a planted symlink-to-directory instead of treating it as the
  # destination directory and moving the temporary file through the link.
  mv -T "$tmp" "$STORE"
}

# ---- reading ---------------------------------------------------------------

cmd_list() {
  read_hosts
}

# Accepts an id or a name, so the CLI stays typeable while the panel passes ids.
resolve() {
  local key="$1"
  read_store | jq -e --arg k "$key" \
    'first(.hosts[] | select(.id == $k or .name == $k))' 2>/dev/null \
    || die "no such machine: $key"
}

cmd_show() {
  [[ $# -ge 1 ]] || die "show needs an id or name"
  resolve "$1"
}

# ---- writing ---------------------------------------------------------------

# Shared flag parser for add and set. Only the flags actually passed end up in
# $fields, so `set` can change one value without the caller restating the rest.
parse_fields() {
  fields='{}'
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --name) fields=$(jq -c --arg v "$2" '.name = $v' <<<"$fields"); shift 2 ;;
    --host) fields=$(jq -c --arg v "$2" '.host = $v' <<<"$fields"); shift 2 ;;
    --user) fields=$(jq -c --arg v "$2" '.user = $v' <<<"$fields"); shift 2 ;;
    --port)
      [[ ${2:-} =~ ^[0-9]+$ ]] && ((10#$2 >= 1 && 10#$2 <= 65535)) \
        || die "port must be a number between 1 and 65535"
      fields=$(jq -c --argjson v "$((10#$2))" '.port = $v' <<<"$fields"); shift 2 ;;
    --identity) fields=$(jq -c --arg v "$2" '.identity = $v' <<<"$fields"); shift 2 ;;
    --path) fields=$(jq -c --arg v "$2" '.path = $v' <<<"$fields"); shift 2 ;;
    --init) fields=$(jq -c --arg v "$2" '.init = $v' <<<"$fields"); shift 2 ;;
    --init-file)
      [[ -r ${2:-} ]] || die "cannot read $2"
      fields=$(jq -c --rawfile v "$2" '.init = $v' <<<"$fields"); shift 2 ;;
    --agent) fields=$(jq -c '.forwardAgent = true' <<<"$fields"); shift ;;
    --no-agent) fields=$(jq -c '.forwardAgent = false' <<<"$fields"); shift ;;
    --persist) fields=$(jq -c '.persist = true' <<<"$fields"); shift ;;
    --no-persist) fields=$(jq -c '.persist = false' <<<"$fields"); shift ;;
    *) die "unknown flag: $1" ;;
    esac
  done
}

new_id() {
  printf 'h%s%04d' "$(date +%s)" "$((RANDOM % 10000))"
}

cmd_add() {
  local fields store updated
  parse_fields "$@"
  store=$(read_store)

  local host name id
  host=$(jq -r '.host // ""' <<<"$fields")
  [[ -n $host ]] || die "add needs --host"
  name=$(jq -r '.name // ""' <<<"$fields")
  [[ -n $name ]] || fields=$(jq -c --arg v "$host" '.name = $v' <<<"$fields")
  id=$(new_id)

  updated=$(jq --arg id "$id" --argjson f "$fields" \
    '.hosts = ((.hosts // []) + [{
        id: $id, name: "", host: "", user: "", port: 22,
        identity: "", path: "", init: "", forwardAgent: false,
        persist: false
      } * $f])' <<<"$store")
  write_store <<<"$updated"

  echo "$id"
}

cmd_set() {
  [[ $# -ge 1 ]] || die "set needs an id"
  local id="$1"; shift
  local fields store updated
  parse_fields "$@"
  store=$(read_store)

  jq -e --arg id "$id" 'any(.hosts[]; .id == $id)' <<<"$store" >/dev/null \
    || die "no such machine: $id"

  updated=$(jq --arg id "$id" --argjson f "$fields" \
    '.hosts = [.hosts[] | if .id == $id then . * $f else . end]' <<<"$store")
  write_store <<<"$updated"
}

cmd_rm() {
  [[ $# -ge 1 ]] || die "rm needs an id or name"
  local id store updated
  store=$(read_store)
  id=$(jq -er --arg k "$1" \
    'first(.hosts[] | select(.id == $k or .name == $k)) | .id' <<<"$store") \
    || die "no such machine: $1"
  updated=$(jq --arg id "$id" '.hosts = [.hosts[] | select(.id != $id)]' <<<"$store")
  write_store <<<"$updated"
}

# ---- connecting ------------------------------------------------------------

# POSIX single-quoting, so a path or script carrying quotes, spaces or $ still
# arrives on the far side as the bytes the user typed.
sq() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# Builds the ssh argv for a machine and prints it NUL-separated, so an init
# script containing newlines survives being read back.
ssh_argv() {
  local entry="$1"
  local id host user port identity path init agent persist
  id=$(jq -r '.id // ""' <<<"$entry")
  host=$(jq -r '.host // ""' <<<"$entry")
  user=$(jq -r '.user // ""' <<<"$entry")
  port=$(jq -r '.port // 22' <<<"$entry")
  identity=$(jq -r '.identity // ""' <<<"$entry")
  path=$(jq -r '.path // ""' <<<"$entry")
  init=$(jq -r '.init // ""' <<<"$entry")
  agent=$(jq -r '.forwardAgent // false' <<<"$entry")
  persist=$(jq -r '.persist // false' <<<"$entry")

  [[ -n $host ]] || die "machine has no host"
  # ssh has no `--` to end its options, so a destination or user beginning with
  # a dash would be read as one — a crafted -oProxyCommand runs locally. The
  # store reader refuses these too; this is the guard at the sink.
  [[ $host != -* ]] || die "refusing host that would be read as an ssh option"
  [[ $user != -* ]] || die "refusing user that would be read as an ssh option"

  local -a argv=(ssh -t)
  # -t is unconditional: without a forced tty an init script turns the
  # session into a non-interactive pipe and nothing you type afterwards works.
  [[ -n $port && $port != "null" && $port != 22 && $port != 0 ]] && argv+=(-p "$port")
  [[ -n $identity && $identity != "null" ]] && argv+=(-i "${identity/#\~/$HOME}")
  [[ $agent == true ]] && argv+=(-A)
  argv+=("${user:+$user@}$host")

  # An initial path and a startup script are the same thing to ssh: a remote
  # command. And ssh runs remote commands through a shell that is neither a
  # login shell nor interactive, so nothing that builds PATH on the far side —
  # /etc/profile, ~/.profile, ~/.bashrc, mise/asdf/nvm shims, ~/.local/bin —
  # has run at that point, and a command that works fine when you log in by
  # hand comes back as "command not found". Running the script through
  # `$SHELL -lc` sources the same startup files an interactive login would,
  # and the trailing exec hands the session over still carrying that PATH.
  local script=""
  [[ -n $path && $path != "null" ]] && script+="cd $(sq "$path") || exit 1"$'\n'
  [[ -n $init && $init != "null" ]] && script+="$init"$'\n'

  # What the login shell is asked to do: the startup script, then hand the
  # session over to an interactive login shell rather than disconnecting.
  local body="${script}exec \"\$SHELL\" -l"

  if [[ $persist == true ]]; then
    argv+=("exec \"\$SHELL\" -lc $(sq "$(tmux_body "$id" "$body")")")
  elif [[ -n $script ]]; then
    argv+=("exec \"\$SHELL\" -lc $(sq "$body")")
  fi

  printf '%s\0' "${argv[@]}"
}

# tmux session names are per machine and derived from the id, not the name:
# renaming a machine in the panel must not strand the session you are in the
# middle of. `.` and `:` are the two bytes tmux reads as window and pane
# separators, so anything outside the safe set is folded away.
tmux_session() {
  local id="${1//[^A-Za-z0-9_-]/-}"
  printf 'hop-%s' "${id:-default}"
}

# Wraps a session so it survives the terminal it was opened in.
#
# `new-session -A` attaches to the session if it is already there and creates
# it otherwise, which is the whole feature: close the window, lose the laptop's
# wifi, reboot the bar — the work is still running, and opening the machine
# again puts you back in front of it. -D detaches whatever client was attached
# before, so a client stranded by a dead terminal cannot hold the session at
# its old size.
#
# On the reattach path tmux ignores the command, so the startup script runs
# once, when the session is created, and coming back does not start a second
# copy of whatever it launched.
#
# The command tmux is given runs through `$SHELL -lc` a second time on purpose:
# panes inherit the environment of the tmux *server*, which may have been
# started long ago by something with a different PATH, so the far side has to
# build its own again. tmux itself is looked for from inside the login shell
# for the same reason — on the machines where it lives in ~/.local/bin, the
# shell ssh hands the command to has never seen that directory.
tmux_body() {
  local id="$1" body="$2"
  local attach="exec \"\$SHELL\" -lc $(sq "$body")"
  local start="exec tmux new-session -A -D"
  start+=" -s $(sq "$(tmux_session "$id")") $(sq "$attach")"
  # Falls through to the plain session on a machine without tmux, rather than
  # failing in a terminal that is about to close and take the message with it.
  printf 'command -v tmux >/dev/null 2>&1 && %s\n%s' "$start" "$body"
}

# gvfs speaks sftp:// natively, which is why this opens a URI rather than
# mounting anything: Files does the connecting, and it reuses a mount that is
# already up instead of making a second one.
files_uri() {
  local entry="$1"
  local host user port path
  host=$(jq -r '.host // ""' <<<"$entry")
  user=$(jq -r '.user // ""' <<<"$entry")
  port=$(jq -r '.port // 22' <<<"$entry")
  path=$(jq -r '.path // ""' <<<"$entry")

  [[ -n $host ]] || die "machine has no host"
  [[ $host != -* ]] || die "refusing host that would be read as an ssh option"
  [[ $user != -* ]] || die "refusing user that would be read as an ssh option"

  # gvfs does not expand ~ and has no idea what the remote home is, so an
  # empty path lands you at / every time. The login user's home is the right
  # guess almost everywhere; the initial path is there for the machines where
  # it is not.
  if [[ -z $path || $path == "null" ]]; then
    case "$user" in
    "") path="/" ;;
    root) path="/root" ;;
    *) path="/home/$user" ;;
    esac
  fi
  [[ $path == /* ]] || path="/$path"
  # Per segment, so the separators survive and a folder with a space does too.
  path=$(jq -rn --arg p "$path" '[$p | split("/")[] | @uri] | join("/")')

  local authority="$host"
  [[ -n $user && $user != "null" ]] && authority="$user@$authority"
  [[ -n $port && $port != "null" && $port != 22 && $port != 0 ]] && authority="$authority:$port"

  printf 'sftp://%s%s\n' "$authority" "$path"
}

cmd_uri() {
  [[ $# -ge 1 ]] || die "uri needs an id or name"
  files_uri "$(resolve "$1")"
}

# ---- launching -------------------------------------------------------------

# Hands a launcher off so that it outlives this script, and — the part that
# matters — the process that ran this script.
#
# The bar is a long-lived shell process that spawns `hop` as a child and keeps
# a handle on that pid. `setsid` on its own does not break that link: it forks
# only when it is already a process group leader, and a child of the bar is
# not one, so it calls setsid() in place and the exec chain keeps hop's pid.
# The terminal then *becomes* the process the bar is holding, and the bar takes
# it down whenever it lets go of that handle — on a shell reload, on an Omarchy
# update, or simply when the next machine is opened through the same slot. A
# session you were working in disappears for a reason that has nothing to do
# with it. --fork makes the fork unconditional, so the window is orphaned onto
# systemd, in its own session and its own scope, where nothing upstream can
# reach it.
#
# Its stdio goes to /dev/null for the same reason: an inherited pipe would keep
# the bar reading from a terminal for as long as that window stayed open, and
# would turn an emulator's harmless startup warning into the panel's error
# line. Anything wrong with the launch itself is reported before we get here.
detach() {
  setsid --fork "$@" </dev/null >/dev/null 2>&1
}

cmd_files() {
  [[ $# -ge 1 ]] || die "files needs an id or name"
  local uri
  uri=$(files_uri "$(resolve "$1")")

  # Nothing is registered for x-scheme-handler/sftp on a stock install, so
  # xdg-open would fail on the URI — go to the file manager directly and keep
  # xdg-open as the fallback for desktops that do register one.
  local -a launcher=()
  command -v uwsm-app >/dev/null && launcher=(uwsm-app --)

  if command -v nautilus >/dev/null; then
    detach "${launcher[@]}" nautilus --new-window "$uri"
  elif command -v xdg-open >/dev/null; then
    detach xdg-open "$uri"
  else
    die "no file manager found"
  fi
}

cmd_command() {
  [[ $# -ge 1 ]] || die "command needs an id or name"
  local -a argv=()
  mapfile -d '' -t argv < <(ssh_argv "$(resolve "$1")")
  printf '%q ' "${argv[@]}"
  echo
}

cmd_connect() {
  [[ $# -ge 1 ]] || die "connect needs an id or name"
  local entry name
  entry=$(resolve "$1")
  name=$(jq -r '.name // .host' <<<"$entry")

  local -a argv=()
  mapfile -d '' -t argv < <(ssh_argv "$entry")

  # omarchy-launch-tui is the supported way to reach the terminal the user
  # actually chose; the fallback keeps this script usable on a plain desktop.
  if command -v omarchy-launch-tui >/dev/null; then
    detach omarchy-launch-tui "--app-id=$APP_ID" "${argv[@]}"
  elif command -v xdg-terminal-exec >/dev/null; then
    detach xdg-terminal-exec "--app-id=$APP_ID" -e "${argv[@]}"
  else
    die "no terminal launcher found (omarchy-launch-tui or xdg-terminal-exec)"
  fi
}

usage() {
  cat <<'USAGE'
hop — SSH machines in the Omarchy bar

  hop list                       every saved machine as JSON
  hop show <id|name>             one machine as JSON
  hop add --host H [flags]       add a machine, prints its id
  hop set <id> [flags]           change only the flags you pass
  hop rm <id|name>               forget a machine
  hop connect <id|name>          open a session in the default terminal
  hop files <id|name>            browse the machine in Files over SFTP
  hop uri <id|name>              print the sftp:// URL instead of opening it
  hop command <id|name>          print the ssh command that would run

Flags for add/set:
  --name N          label shown in the bar (defaults to the host)
  --host H          hostname, IP, or a Host alias from ~/.ssh/config
  --user U          remote user (omit to let ssh_config decide)
  --port P          port (default 22)
  --identity F      private key file
  --path P          where sessions start: the terminal cds here and Files
                    opens here (default: the login user's home)
  --init S          shell snippet to run on arrival
  --init-file F     same, read from a file
  --agent/--no-agent   forward your ssh agent
  --persist/--no-persist
                    keep the session running on the remote machine in tmux,
                    and reattach to it next time instead of starting over

Passwords are never stored: ssh prompts in the terminal it opens.
USAGE
}

case "${1:-}" in
list) shift; cmd_list "$@" ;;
show) shift; cmd_show "$@" ;;
add) shift; cmd_add "$@" ;;
set) shift; cmd_set "$@" ;;
rm | remove) shift; cmd_rm "$@" ;;
connect | open) shift; cmd_connect "$@" ;;
files | browse) shift; cmd_files "$@" ;;
uri) shift; cmd_uri "$@" ;;
command | cmd) shift; cmd_command "$@" ;;
-h | --help | help | "") usage ;;
*) die "unknown command: $1" ;;
esac
